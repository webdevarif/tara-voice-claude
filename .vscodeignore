# Deliberately does NOT ignore node_modules: `ws` is a runtime dependency loaded
# by GeminiVoiceBridge, and vsce already prunes devDependencies when packaging.
# A blanket node_modules ignore made `import('ws')` fail with MODULE_NOT_FOUND in
# an installed build while working fine from the debug host.
#
# @picovoice/pvrecorder-node ships the prebuilt capture binaries, so its lib/**
# must stay. Only its build-time cruft is dropped below — never lib/.
node_modules/@picovoice/pvrecorder-node/src/**
node_modules/@picovoice/pvrecorder-node/copy.js
node_modules/@picovoice/pvrecorder-node/jest.config.js
node_modules/@picovoice/pvrecorder-node/tsconfig.json
node_modules/@picovoice/pvrecorder-node/.eslint*
node_modules/@picovoice/pvrecorder-node/.prettierrc
# Same for @picovoice/eagle-node, whose lib/ is the speaker-recognition engine:
# lib/common holds the model (.pv) and the four platform folders hold the native
# binaries. Dropping any of them would break the voice gate on that platform
# only, which is the worst kind of packaging bug — it passes on the machine that
# built it. So only source, tests and build config go.
node_modules/@picovoice/eagle-node/src/**
node_modules/@picovoice/eagle-node/test/**
node_modules/@picovoice/eagle-node/copy.js
node_modules/@picovoice/eagle-node/jest.config.js
node_modules/@picovoice/eagle-node/tsconfig.json
.vscode/**
.vscode-test/**
src/**
webview-ui/src/**
webview-ui/public/**
webview-ui/node_modules/**
webview-ui/package.json
webview-ui/package-lock.json
webview-ui/tsconfig*.json
webview-ui/vite.config.ts
webview-ui/index.html
webview-ui/kanban.html
webview-ui/README.md
webview-ui/.oxlintrc.json
webview-ui/.gitignore
node_modules/.bin/**
tsconfig.json
.gitignore
.eslintrc*
**/*.map
*.vsix
